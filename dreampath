const [newGoal, setNewGoal] = useState({
title: ‘’,
category: ‘hobbies’,
timeframe: 3,
steps: [’’],
});

// Categories configuration
const categories = [
{ id: ‘education’, label: ‘Learning’, icon: ‘book’, color: ‘#3B82F6’ },
{ id: ‘hobbies’, label: ‘Hobbies’, icon: ‘heart’, color: ‘#EC4899’ },
{ id: ‘friends’, label: ‘Friends’, icon: ‘people’, color: ‘#10B981’ },
{ id: ‘activities’, label: ‘Activities’, icon: ‘trophy’, color: ‘#8B5CF6’ },
{ id: ‘travel’, label: ‘Places’, icon: ‘location’, color: ‘#F97316’ },
];

const timeframes = [
{ value: 3, label: ‘3 Years’, color: ‘#34D399’ },
{ value: 5, label: ‘5 Years’, color: ‘#60A5FA’ },
{ value: 10, label: ‘10 Years’, color: ‘#A78BFA’ },
];

// Load goals from storage on mount
useEffect(() => {
loadGoals();
}, []);

// Save goals whenever they change
useEffect(() => {
saveGoals();
}, [goals]);

const loadGoals = async () => {
try {
const storedGoals = await AsyncStorage.getItem(‘dreampath_goals’);
if (storedGoals) {
setGoals(JSON.parse(storedGoals));
} else {
// Set initial demo goals
setGoals([
{
id: Date.now(),
title: ‘Learn to play guitar’,
category: ‘hobbies’,
timeframe: 3,
completed: false,
steps: [‘Get a guitar’, ‘Find a teacher’, ‘Practice 20 min daily’],
},
{
id: Date.now() + 1,
title: ‘Make the soccer team’,
category: ‘activities’,
timeframe: 3,
completed: false,
steps: [‘Train 3x per week’, ‘Work on dribbling’, ‘Try out in spring’],
},
]);
}
} catch (error) {
console.error(‘Error loading goals:’, error);
}
};

const saveGoals = async () => {
try {
await AsyncStorage.setItem(‘dreampath_goals’, JSON.stringify(goals));
} catch (error) {
console.error(‘Error saving goals:’, error);
}
};

const addGoal = () => {
if (newGoal.title.trim()) {
setGoals([
…goals,
{
id: Date.now(),
…newGoal,
completed: false,
steps: newGoal.steps.filter((s) => s.trim()),
},
]);
setNewGoal({ title: ‘’, category: ‘hobbies’, timeframe: 3, steps: [’’] });
setShowAddGoal(false);
}
};

const deleteGoal = (id) => {
Alert.alert(
‘Delete Dream’,
‘Are you sure you want to delete this dream?’,
[
{ text: ‘Cancel’, style: ‘cancel’ },
{
text: ‘Delete’,
style: ‘destructive’,
onPress: () => setGoals(goals.filter((g) => g.id !== id)),
},
]
);
};

const toggleComplete = (id) => {
setGoals(goals.map((g) => (g.id === id ? { …g, completed: !g.completed } : g)));
};

const getCategoryInfo = (catId) => categories.find((c) => c.id === catId);
const getTimeframeInfo = (tf) => timeframes.find((t) => t.value === tf);

const addStepField = () => {
setNewGoal({ …newGoal, steps: […newGoal.steps, ‘’] });
};

const updateStep = (index, value) => {
const newSteps = […newGoal.steps];
newSteps[index] = value;
setNewGoal({ …newGoal, steps: newSteps });
};

// Render Goal Card
const GoalCard = ({ goal, showTimeframe = false }) => {
const cat = getCategoryInfo(goal.category);
const tf = getTimeframeInfo(goal.timeframe);

